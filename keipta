const ASSETS=[
 {s:'WHL',n:'Whale Index',p:124.80,icon:'WH',v:'48.2M'}, {s:'ORCA',n:'Orca Systems',p:86.42,icon:'OR',v:'32.7M'}, {s:'TIDE',n:'Tide Network',p:42.16,icon:'TD',v:'18.4M'}, {s:'NOVA',n:'Nova Labs',p:212.75,icon:'NV',v:'66.1M'}, {s:'AERO',n:'Aero Dynamics',p:58.93,icon:'AE',v:'21.5M'}, {s:'LUMA',n:'Luma Energy',p:31.08,icon:'LU',v:'15.8M'}, {s:'MINT',n:'Mint Systems',p:9.74,icon:'MI',v:'8.2M'}, {s:'GLXY',n:'Galaxy Media',p:172.30,icon:'GX',v:'43.9M'}, {s:'PEAK',n:'Peak Industries',p:306.12,icon:'PK',v:'74.3M'}, {s:'FLOW',n:'Flow Robotics',p:67.21,icon:'FL',v:'26.8M'}
];
const START=100000, FEE=.001, KEY='whaleMarketsPracticeV4';
let state={cash:START,realized:0,selected:'WHL',positions:{},history:[],wins:0,losses:0,tradeCount:0,largestWin:0,largestLoss:0,name:'Guest Trader',avatar:'',equity:[START],startTime:Date.now()};
try{const saved=JSON.parse(localStorage.getItem(KEY)||'null');if(saved&&typeof saved==='object'){state={...state,...saved,positions:saved.positions||{},history:saved.history||[],equity:saved.equity||[START]};}}catch(e){}
let series={},prices={},changes={},running=false,gridOn=true,frame='1m',speed=1,side='buy',ticks=0,timer=null,activeAvatarURL='';
function randn(){let u=0,v=0;while(!u)u=Math.random();while(!v)v=Math.random();return Math.sqrt(-2*Math.log(u))*Math.cos(2*Math.PI*v);}
function seedSeries(asset){let p=asset.p,arr=[],now=Date.now();for(let i=0;i<110;i++){let o=p*(1+randn()*.009),c=o*(1+randn()*.007);p=c;arr.push({o,h:Math.max(o,c)*(1+Math.random()*.006),l:Math.min(o,c)*(1-Math.random()*.006),c,v:Math.random()*1000,t:now-(110-i)*60000});}return arr;}
ASSETS.forEach(a=>{series[a.s]=seedSeries(a);prices[a.s]=series[a.s].at(-1).c;changes[a.s]=(Math.random()-.44)*4;});
