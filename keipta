function totalPnl(){return equity()-START;}
function activePositions(){return ASSETS.filter(a=>posFor(a.s).qty>1e-8);}
function changeView(view){document.querySelectorAll('.view').forEach(x=>x.classList.toggle('active',x.id==='view-'+view));document.querySelectorAll('[data-view]').forEach(x=>x.classList.toggle('active',x.dataset.view===view));if(view==='markets')renderMarkets();if(view==='portfolio')renderPortfolio();if(view==='analytics')renderAnalytics();if(view==='profile')renderProfile();if(view==='terminal')drawChart();window.scrollTo({top:0,behavior:'smooth'});}
