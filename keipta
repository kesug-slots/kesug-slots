function updateOrderSummary(){let amount=Math.max(0,Number($('orderAmount').value)||0),price=prices[state.selected]||1,qty=amount/price,fee=amount*FEE,p=posFor(state.selected);if(side==='sell'){amount=Math.min(amount,positionValue(state.selected));qty=amount/price;fee=amount*FEE;}$('estimatedQty').textContent=qty.toFixed(5)+' '+state.selected;$('estimatedFee').textContent=money(fee);$('availableCash').textContent=money(state.cash);$('placeOrder').disabled=side==='buy'?amount<=0||amount+fee>state.cash:amount<=0||p.qty<=0;}
$('orderAmount').addEventListener('input',updateOrderSummary);
function placeOrder(){let amount=Math.max(0,Number($('orderAmount').value)||0),sym=state.selected,price=prices[sym],p=posFor(sym);if(amount<=0){toast('Укажи сумму больше нуля.','error');return;}if(side==='buy'){let fee=amount*FEE;if(amount+fee>state.cash){toast('Недостаточно виртуальных средств.','error');return;}let qty=amount/price,oldValue=p.qty*p.avg,newQty=p.qty+qty;state.positions[sym]={qty:newQty,avg:(oldValue+amount)/newQty};state.cash-=amount+fee;state.tradeCount++;state.history.unshift({type:'BUY',symbol:sym,qty,price,value:amount+fee,pnl:0,time:Date.now()});toast(`Виртуальная покупка: ${qty.toFixed(4)} ${sym}`);}else{amount=Math.min(amount,positionValue(sym));if(amount<=0||p.qty<=0){toast('Нет открытой позиции для продажи.','error');return;}let qty=Math.min(p.qty,amount/price),gross=qty*price,fee=gross*FEE,cost=qty*p.avg,pl=gross-cost-fee;state.cash+=gross-fee;state.realized+=pl;state.tradeCount++;if(pl>0){state.wins++;state.largestWin=Math.max(state.largestWin,pl);}else{state.losses++;state.largestLoss=Math.min(state.largestLoss,pl);}state.positions[sym]={qty:Math.max(0,p.qty-qty),avg:p.avg};if(state.positions[sym].qty<1e-8)delete state.positions[sym];state.history.unshift({type:'SELL',symbol:sym,qty,price,value:gross-fee,pnl:pl,time:Date.now()});toast(`Виртуальная продажа: ${qty.toFixed(4)} ${sym} · ${pl>=0?'+':''}${money(pl)}`);}state.history=state.history.slice(0,100);state.equity.push(equity());if(state.equity.length>250)state.equity.shift();persist();updateAll();}
$('placeOrder').onclick=placeOrder;
function updateAll(){updateTopMetrics();selectAssetQuiet();renderWatch();renderActivity();renderTickers();if($('view-portfolio').classList.contains('active'))renderPortfolio();if($('view-analytics').classList.contains('active'))renderAnalytics();updateOrderSummary();}
function selectAssetQuiet(){const a=selectedAsset();$('assetIcon').textContent=a.icon;$('assetName').textContent=a.n;$('assetTicker').textContent=a.s+' · Simulated asset';$('assetPrice').textContent=fmtPrice(prices[a.s]);$('assetChange').textContent=pct(changes[a.s]||0);$('assetChange').className='price-change '+(changes[a.s]>=0?'positive':'negative');}
function drawChart(){const c=$('priceChart');if(!c||!c.clientWidth)return;const dpr=Math.min(devicePixelRatio||1,2),w=c.clientWidth,h=c.clientHeight;c.width=Math.round(w*dpr);c.height=Math.round(h*dpr);const x=c.getContext('2d');x.setTransform(dpr,0,0,dpr,0,0);x.clearRect(0,0,w,h);const raw=(series[state.selected]||[]),groupSize=({'1m':1,'5m':2,'15m':5,'1h':10,'1d':20}[frame]||1),grouped=[];for(let i=0;i<raw.length;i+=groupSize){const g=raw.slice(i,i+groupSize);if(!g.length)continue;grouped.push({o:g[0].o,h:Math.max(...g.map(z=>z.h)),l:Math.min(...g.map(z=>z.l)),c:g[g.length-1].c,v:g.reduce((sum,z)=>sum+z.v,0),t:g[0].t});}const bars=grouped.slice(-80),left=54,right=12,top=13,bottom=29,plotW=w-left-right,plotH=h-top-bottom;if(bars.length<2)return;let min=Math.min(...bars.map(b=>b.l)),max=Math.max(...bars.map(b=>b.h));let pad=(max-min)*.12||1;min-=pad;max+=pad;const Y=v=>top+(max-v)/(max-min)*plotH; x.font='9px Inter';x.fillStyle='#697587';x.textAlign='right';for(let i=0;i<=4;i++){let val=max-(max-min)*i/4,y=top+plotH*i/4;if(gridOn){x.strokeStyle='rgba(255,255,255,.07)';x.beginPath();x.moveTo(left,y);x.lineTo(w-right,y);x.stroke();}x.fillText(fmtPrice(val),left-8,y+3);}const step=plotW/bars.length,cw=Math.max(2,step*.56);bars.forEach((b,i)=>{let xx=left+i*step+step/2,up=b.c>=b.o;x.strokeStyle=up?'#dedee2':'#77777d';x.fillStyle=up?'#dedee2':'#77777d';x.lineWidth=1;x.beginPath();x.moveTo(xx,Y(b.h));x.lineTo(xx,Y(b.l));x.stroke();let y=Y(Math.max(b.o,b.c)),bh=Math.max(1,Math.abs(Y(b.o)-Y(b.c)));x.fillRect(xx-cw/2,y,cw,bh);});let last=bars.at(-1).c,ly=Y(last);x.setLineDash([4,4]);x.strokeStyle='rgba(220,220,225,.42)';x.beginPath();x.moveTo(left,ly);x.lineTo(w-right,ly);x.stroke();x.setLineDash([]);x.fillStyle='#d8d8dc';x.beginPath();x.arc(w-right,ly,3,0,Math.PI*2);x.fill();x.textAlign='left';x.fillStyle='#718093';let labels=['09:30','10:15','11:00','11:45','12:30'];labels.forEach((l,i)=>x.fillText(l,left+i*plotW/4,h-8));$('barCounter').textContent=bars.length;}
function drawEquity(){const c=$('equityChart');if(!c||!c.clientWidth)return;const dpr=Math.min(devicePixelRatio||1,2),w=c.clientWidth,h=c.clientHeight;c.width=w*dpr;c.height=h*dpr;const x=c.getContext('2d');x.setTransform(dpr,0,0,dpr,0,0);x.clearRect(0,0,w,h);const vals=state.equity.length>1?state.equity:[START,START];let min=Math.min(...vals,START)*.995,max=Math.max(...vals,START)*1.005;if(max===min)max=min+1;const X=i=>10+i*(w-20)/(vals.length-1),Y=v=>12+(max-v)/(max-min)*(h-30);x.strokeStyle='#ffffff12';for(let i=0;i<4;i++){let y=12+i*(h-30)/3;x.beginPath();x.moveTo(10,y);x.lineTo(w-10,y);x.stroke();}x.beginPath();vals.forEach((v,i)=>i?x.lineTo(X(i),Y(v)):x.moveTo(X(i),Y(v)));x.strokeStyle='#c9c9ce';x.lineWidth=2;x.stroke();x.lineTo(X(vals.length-1),h-15);x.lineTo(X(0),h-15);x.closePath();let g=x.createLinearGradient(0,10,0,h);g.addColorStop(0,'#d0d0d033');g.addColorStop(1,'#d0d0d000');x.fillStyle=g;x.fill();}
function advance(){ticks++;ASSETS.forEach(a=>{let arr=series[a.s],last=arr.at(-1),vol=.0025+Math.random()*.004,drift=randn()*vol;let o=last.c,c=Math.max(.05,o*(1+drift));let n={o,h:Math.max(o,c)*(1+Math.random()*.003),l:Math.min(o,c)*(1-Math.random()*.003),c,v:Math.random()*1200,t:Date.now()};arr.push(n);if(arr.length>180)arr.shift();prices[a.s]=c;changes[a.s]=((c-a.p)/a.p)*100;});$('sessionClock').textContent=new Date(9*3600000+30*60000+ticks*60000).toISOString().slice(11,19)+' ET';let sym=state.selected,p=posFor(sym),price=prices[sym];let stop=Number($('stopPrice').value),target=Number($('targetPrice').value);if(p.qty>0&&((stop>0&&price<=stop)||(target>0&&price>=target))){let reason=stop>0&&price<=stop?'Practice stop triggered':'Practice target reached';state.cash+=p.qty*price*(1-FEE);let pl=p.qty*(price-p.avg)-p.qty*price*FEE;state.realized+=pl;state.history.unshift({type:'SELL',symbol:sym,qty:p.qty,price,value:p.qty*price,pnl:pl,time:Date.now(),note:reason});if(pl>=0)state.wins++;else state.losses++;delete state.positions[sym];state.tradeCount++;state.equity.push(equity());toast(reason+' · position closed');}
updateAll();drawChart();if(ticks%5===0){state.equity.push(equity());if(state.equity.length>250)state.equity.shift();persist();}}
function setRunning(v){running=v;$('playBtn').textContent=running?'Ⅱ Pause replay':'▶ Start replay';if(timer)clearInterval(timer);timer=null;if(running)timer=setInterval(advance,1000/speed);}
$('playBtn').onclick=()=>setRunning(!running);$('stepBtn').onclick=()=>{if(!running)advance();};$('restartBtn').onclick=()=>{setRunning(false);ticks=0;ASSETS.forEach(a=>series[a.s]=seedSeries(a));ASSETS.forEach(a=>prices[a.s]=series[a.s].at(-1).c);$('sessionClock').textContent='09:30:00 ET';drawChart();updateAll();toast('Replay restarted. Your practice account was kept.');};$('speedSelect').onchange=e=>{speed=Number(e.target.value);if(running)setRunning(true);};$('resetChart').onclick=()=>{$('restartBtn').click();};$('toggleGrid').onclick=()=>{gridOn=!gridOn;drawChart();};
$('timeframeTabs').querySelectorAll('[data-frame]').forEach(b=>b.onclick=()=>{frame=b.dataset.frame;$('timeframeTabs').querySelectorAll('.tab').forEach(t=>t.classList.toggle('active',t===b));drawChart();});
$('globalSearch').addEventListener('keydown',e=>{if(e.key==='Enter'){const q=e.target.value.trim().toUpperCase();const found=ASSETS.find(a=>a.s===q||a.n.toUpperCase().includes(q));if(found){selectAsset(found.s);changeView('terminal');}else{changeView('markets');$('marketSearch').value=e.target.value;renderMarkets(e.target.value);}}});document.addEventListener('keydown',e=>{if((e.ctrlKey||e.metaKey)&&e.key.toLowerCase()==='k'){e.preventDefault();$('globalSearch').focus();}if(e.target.matches('input,textarea,select'))return;if(e.code==='Space'){e.preventDefault();setRunning(!running);}if(e.key.toLowerCase()==='b'){side='buy';updateSideUI();}if(e.key.toLowerCase()==='s'){side='sell';updateSideUI();}});
$('saveProfile').onclick=()=>{const name=$('profileName').value.trim().slice(0,24)||'Guest Trader';state.name=name;persist();renderProfile();toast('Профиль сохранён в этом браузере.');};$('profileName').addEventListener('input',e=>$('profileNamePreview').textContent=e.target.value||'Guest Trader');
$('avatarFile').addEventListener('change',e=>{const file=e.target.files&&e.target.files[0];if(!file)return;if(!/^image\/(png|jpeg|webp|gif)$/.test(file.type)){toast('Выбери PNG, JPG, WEBP или GIF.','error');return;}if(file.size>1.5*1024*1024){toast('Фото должно быть меньше 1.5 MB.','error');e.target.value='';return;}const reader=new FileReader();reader.onload=()=>{const img=new Image();img.onload=()=>{const canvas=document.createElement('canvas'),size=256;canvas.width=size;canvas.height=size;const ctx=canvas.getContext('2d'),scale=Math.max(size/img.width,size/img.height),w=img.width*scale,h=img.height*scale;ctx.drawImage(img,(size-w)/2,(size-h)/2,w,h);state.avatar=canvas.toDataURL('image/jpeg',.82);persist();renderHeader();renderProfile();toast('Аватар загружен с устройства.');};img.onerror=()=>toast('Не удалось прочитать изображение.','error');img.src=reader.result;};reader.readAsDataURL(file);});
$('resetAccount').onclick=()=>{if(!confirm('Сбросить виртуальный баланс, позиции и историю? Профиль останется.'))return;const name=state.name,avatar=state.avatar;state={cash:START,realized:0,selected:'WHL',positions:{},history:[],wins:0,losses:0,tradeCount:0,largestWin:0,largestLoss:0,name,avatar,equity:[START],startTime:Date.now()};persist();updateAll();renderPortfolio();renderAnalytics();toast('Учебный аккаунт сброшен.');};
$('exportHistory').onclick=()=>{const rows=[['Type','Symbol','Units','Price','Value','P&L','Time'],...state.history.map(h=>[h.type,h.symbol,h.qty,h.price,h.value,h.pnl,new Date(h.time).toISOString()])];const csv=rows.map(r=>r.map(v=>'"'+String(v??'').replace(/"/g,'""')+'"').join(',')).join('\n');const a=document.createElement('a');a.href=URL.createObjectURL(new Blob([csv],{type:'text/csv'}));a.download='whale-markets-practice-history.csv';a.click();URL.revokeObjectURL(a.href);};
$('startWorkspace').onclick=()=>{state.name=$('welcomeName').value.trim().slice(0,24)||'Guest Trader';persist();$('welcomeModal').classList.remove('show');renderHeader();renderProfile();toast('Рабочее место готово. Удачной практики!');};
function init(){renderHeader();renderTickers();selectAsset(state.selected);updateAll();renderMarkets();renderProfile();if(!localStorage.getItem(KEY+'-welcomed')){$('welcomeModal').classList.add('show');$('startWorkspace').addEventListener('click',()=>localStorage.setItem(KEY+'-welcomed','1'),{once:true});}window.addEventListener('resize',()=>{drawChart();drawEquity();});setInterval(()=>{if(!running){/* keep interface clock current without moving prices */}},5000);}
init();
})();
</script>
