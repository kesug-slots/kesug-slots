function makeAvatar(name){const initials=(name||'G').trim().split(/\s+/).slice(0,2).map(x=>x[0]).join('').toUpperCase()||'G';const svg=`<svg xmlns="http://www.w3.org/2000/svg" width="128" height="128"><defs><linearGradient id="g" x2="1" y2="1"><stop stop-color="#68686e"/><stop offset="1" stop-color="#29292e"/></linearGradient></defs><rect width="128" height="128" rx="38" fill="url(#g)"/><text x="64" y="76" text-anchor="middle" font-family="Arial" font-weight="700" font-size="42" fill="#e8fff5">${initials.replace(/[<&>]/g,'')}</text></svg>`;return 'data:image/svg+xml;charset=UTF-8,'+encodeURIComponent(svg);}
